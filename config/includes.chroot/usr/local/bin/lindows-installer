#!/bin/sh
set -eu

if ! command -v calamares >/dev/null 2>&1; then
    echo "Calamares is not installed in this Lindows Live session." >&2
    exit 1
fi

# Calamares needs administrative access to partition and install. A narrowly
# scoped Polkit rule grants only the Live `user` permission to run this one
# installer binary, so the graphical entry does not silently exit on auth.
exec /usr/bin/pkexec /usr/bin/calamares "$@"
