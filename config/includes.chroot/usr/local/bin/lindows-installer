#!/bin/sh
set -eu

if ! command -v calamares >/dev/null 2>&1; then
    echo "Calamares is not installed in this Lindows Live session." >&2
    exit 1
fi

# Calamares needs administrative access to partition and install. The Live
# image grants only this one binary passwordless root execution to `user`,
# avoiding a second PolicyKit identity prompt in the Live session.
exec sudo -n /usr/bin/calamares "$@"
