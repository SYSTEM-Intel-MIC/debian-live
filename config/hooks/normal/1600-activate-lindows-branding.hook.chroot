#!/bin/sh
set -eu

# Fail the image build early if the installed target cannot perform a real
# Calamares installation. unpackfs executes unsquashfs inside the target.
command -v unsquashfs >/dev/null 2>&1 || {
    echo "Lindows: squashfs-tools/unsquashfs is required in the target" >&2
    exit 1
}
command -v rsync >/dev/null 2>&1 || {
    echo "Lindows: rsync is required by Calamares unpackfs" >&2
    exit 1
}
find /usr/lib -path '*/calamares/modules/partition/libcalamares_viewmodule_partition.so' -print -quit | grep -q . || {
    echo "Lindows: Calamares partition module is missing" >&2
    exit 1
}
find /usr/lib -path '*/calamares/modules/mount/module.desc' -print -quit | grep -q . || {
    echo "Lindows: Calamares mount module is missing" >&2
    exit 1
}

# calamares-settings-debian supplies the tested Debian module sequence. Keep
# that sequence but replace its selected branding component with Lindows.
SETTINGS=/etc/calamares/settings.conf
if [ ! -f "$SETTINGS" ]; then
    echo "Lindows: Calamares settings are missing" >&2
    exit 1
fi
if grep -qE '^[[:space:]]*branding:' "$SETTINGS"; then
    sed -i -E 's|^([[:space:]]*branding:)[[:space:]]*.*$|\1 lindows|' "$SETTINGS"
else
    echo "Lindows: Calamares settings have no branding selector" >&2
    exit 1
fi

# Calamares requires an explicit slideshow key. The Lindows source tree ships
# its own show.qml; never copy Debian's placeholder slideshow over it.
BRANDING=/etc/calamares/branding/lindows
if [ ! -f "$BRANDING/show.qml" ]; then
    echo "Lindows: custom Calamares show.qml is missing" >&2
    exit 1
fi
if ! grep -q '^slideshow:' "$BRANDING/branding.desc"; then
    printf '\nslideshow: "show.qml"\nslideshowAPI: 2\n' >> "$BRANDING/branding.desc"
fi

# The default ElevenDE fallback makes the brand wallpaper available even if a
# Live-user skeleton is not copied by a particular live-config profile.
install -Dm644 /usr/share/lindows/branding/lindows-aurora-wallpaper.png \
    /usr/local/share/elevende-shell/wallpaper.png
install -Dm644 /usr/share/lindows/branding/lindows-aurora-wallpaper.png \
    /etc/skel/.local/share/elevende/wallpaper.png

# Use the Lindows mark as a real ElevenDE theme icon. ElevenDE resolves desktop
# file icons from its own theme before consulting system icon themes.
for size in 64x64 96x96 128x128 scalable; do
    install -Dm644 "$BRANDING/lindows-mark.svg" \
        "/usr/local/share/elevende-shell/icons/$size/apps/lindows-installer.svg"
done

# Make the Live session and Calamares use Simplified Chinese by default.
if [ -f /etc/locale.gen ]; then
    sed -i -E 's/^#[[:space:]]*(zh_CN.UTF-8[[:space:]]+UTF-8)/\1/' /etc/locale.gen
    locale-gen zh_CN.UTF-8
fi
cat > /etc/default/locale <<'EOF'
LANG=zh_CN.UTF-8
LANGUAGE=zh_CN:zh
LC_MESSAGES=zh_CN.UTF-8
EOF

# Remove Debian's generic installer launcher from the application menu. The
# Lindows-branded Calamares entry remains the only graphical installer entry.
for dir in /usr/share/applications /etc/xdg/autostart /etc/skel/Desktop; do
    [ -d "$dir" ] || continue
    find "$dir" -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null | while IFS= read -r -d '' entry; do
        if grep -qiE '(^Name(\[[^]]+\])?=.*(Install Debian|Debian Installer))|debian-installer-launcher|debian-installer.desktop' "$entry" 2>/dev/null; then
            rm -f "$entry"
        fi
    done
done
chmod 0755 '/etc/skel/Desktop/Install Lindows.desktop' 2>/dev/null || true
chmod 0755 /usr/share/applications/lindows-installer.desktop 2>/dev/null || true

# Keep human-readable system identity coherent outside the desktop itself.
printf 'Lindows 1.0 \\n \\l\n' > /etc/issue
printf 'Lindows 1.0\n' > /etc/issue.net

# grub-mkconfig reads /etc/default/grub itself rather than drop-in files.
# Append final assignments so both Live inspection and the installed target use
# the Lindows bootloader identity and theme when update-grub is invoked.
if [ -f /etc/default/grub ]; then
    cat >> /etc/default/grub <<'EOF'

# Lindows bootloader identity and presentation.
GRUB_DISTRIBUTOR="Lindows"
GRUB_THEME="/boot/grub/themes/lindows/theme.txt"
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=6
GRUB_DEFAULT=0
GRUB_DISABLE_OS_PROBER=false
EOF
fi
