#!/bin/sh
set -eu

# live-config may not create its usual `user` account when the image is
# assembled with the Debian Bookworm SysV init path. LightDM is configured to
# autologin this account, so make that contract explicit in the image.
if ! id user >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --user-group user
fi
passwd --delete user >/dev/null 2>&1 || true
for group in audio video plugdev netdev render input; do
    if getent group "$group" >/dev/null 2>&1; then
        usermod --append --groups "$group" user
    fi
done

# Give the Live account the same default ElevenDE configuration as an installed
# account, including the Lindows wallpaper and input method environment.
if [ -d /etc/skel ]; then
    cp -a /etc/skel/. /home/user/ 2>/dev/null || true
fi
chown -R user:user /home/user
# ElevenDE treats non-executable .desktop files as documents; keep the Live
# installer shortcut executable after skeleton copying and ownership changes.
chmod 0755 '/home/user/Desktop/Install Lindows.desktop' 2>/dev/null || true

# The image currently uses SysV init, so explicitly register LightDM in the
# default runlevel. The systemd command is harmless when systemd is present and
# is retained for installed targets using the same filesystem.
if [ -x /etc/init.d/lightdm ]; then
    update-rc.d lightdm defaults >/dev/null 2>&1 || true
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable lightdm.service >/dev/null 2>&1 || true
fi
