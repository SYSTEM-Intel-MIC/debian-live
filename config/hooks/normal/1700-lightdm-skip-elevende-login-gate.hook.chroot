#!/bin/sh
set -eu

# ElevenDE owns the Win11-style graphical login gate. LightDM only starts
# the X11 session; never delete elevende-lock --login from elevende-session.
SESSION=/usr/local/bin/elevende-session
if [ -f "$SESSION" ]; then
    # Start a small PolicyKit agent in the graphical session so the
    # lindows-installer pkexec wrapper can show its authorization dialog.
    sed -i '/^echo "elevende-session: starting compositor/i\\if command -v lxqt-policykit-agent >\/dev\/null 2>\&1; then\n    lxqt-policykit-agent >\/tmp\/lindows-policykit.log 2>\&1 \&\nfi\n' "$SESSION"
fi
