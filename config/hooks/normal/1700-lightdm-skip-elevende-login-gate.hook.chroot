#!/bin/sh
set -eu
# ElevenDE owns the Win11-style graphical login gate on installed systems.
# A LiveCD has a temporary passwordless `user` account, so it must skip the
# gate and enter the desktop directly. The runtime /run/live check keeps this
# distinction out of the installed target.
SESSION=${SESSION:-/usr/local/bin/elevende-session}
if [ -f "$SESSION" ]; then
    python3 - "$SESSION" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()
marker = "# Login gate: show a Win11-style login screen with a password field before\n"
if "if [ ! -d /run/live ]; then" not in text:
    if marker not in text:
        raise SystemExit("ElevenDE login gate marker not found")
    text = text.replace(
        marker,
        "# LiveCD has no user-visible password; only installed systems show the gate.\n"
        "if [ ! -d /run/live ]; then\n" + marker,
        1,
    )
    close = '    echo "elevende-session: unlocked"\nfi\n'
    if close not in text:
        raise SystemExit("ElevenDE login gate close marker not found")
    text = text.replace(close, close + "fi\n", 1)
path.write_text(text)
PY
    # Start a small PolicyKit agent in the graphical session so the
    # lindows-installer pkexec wrapper can show its authorization dialog.
    python3 - "$SESSION" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text()
marker = 'echo "elevende-session: starting compositor (picom)"\n'
agent = '''if command -v lxqt-policykit-agent >/dev/null 2>&1; then
    lxqt-policykit-agent >/tmp/lindows-policykit.log 2>&1 &
fi
'''
if 'lindows-policykit.log' not in text:
    if marker not in text:
        raise SystemExit("ElevenDE compositor marker not found")
    text = text.replace(marker, agent + marker, 1)
path.write_text(text)
PY
fi
