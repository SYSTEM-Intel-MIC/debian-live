#!/bin/sh
# auto/config — live-build 清理钩子
# 注意：不删除 config/ 目录，保留自定义配置文件
# 注意：不要在这里调用 lb config！live-build 会自动用此脚本包装 lb config，
#       如果此脚本调用 lb config 会导致无限递归（auto/config -> lb config -> auto/config -> ...）

set -e

echo "[auto/config] Cleaning up build artifacts..."

# 只清理 live-build 自动生成的目录，不动 config/ 目录
rm -rf lb/ .build/ stage/ cache/

echo "[auto/config] Cleanup done. config/ directory preserved."
