#!/bin/sh
# auto/config — live-build 配置生成
# 注意：不删除 config/ 目录，保留自定义配置文件

set -e

DIST="${DIST:-bookworm}"
ARCH="${ARCH:-amd64}"
MIRROR="${MIRROR:-http://mirrors.aliyun.com/debian/}"

echo "[auto/config] Running lb config..."

# 只清理 live-build 自动生成的目录，不动 config/ 目录
sudo rm -rf lb/ .build/ stage/ cache/

# 生成基础配置
sudo lb config \
    --distribution "${DIST}" \
    --architectures "${ARCH}" \
    --linux-flavours amd64 \
    --bootappend-live "boot=live components splash" \
    --binary-images iso-hybrid \
    --source false \
    --zsync false \
    --firmware-chroot false \
    2>&1

echo "[auto/config] lb config done."
echo "[auto/config] config/ directory preserved."
